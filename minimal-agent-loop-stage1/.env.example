# 必填：OpenAI API 密钥
OPENAI_API_KEY=your_api_key_here

# 必填：填写你的账户有权限使用、且支持 Responses API 和 Function Calling 的模型
OPENAI_MODEL=your_model_name

# 可选：使用官方 OpenAI API 时留空；兼容代理必须真正支持 Responses API
OPENAI_BASE_URL=

# Agent 控制参数
AGENT_MAX_STEPS=8
AGENT_TOTAL_TIMEOUT=120
AGENT_TOOL_TIMEOUT=8
AGENT_API_TIMEOUT=45
